# dependencies
**/node_modules/
**/__pycache__/
**/venv/
**/.venv/

# Environment variables
**/*.env

# Credentials: Google service-account keys, OAuth/auth JSON, TLS keys and
# certificates. Secrets belong in the git-ignored .env files (docs/DEPLOY.md).
**/*service_account*.json
**/*service-account*.json
**/auth/*.json
*.pem
*.key

# Usage analytics CSV logs (access logs that include user emails)
usageAnalytics/logs/

# production
/website/server/build/
website/server/build*
website/build/

# misc
**/.DS_Store
.vscode/

# Canvas importer payload dumps contain student data (fixtures under dbcron/tests/ are fake and tracked)
/dbcron/*.json
/dbcron/dumps/

# Local dev logs from scripts/dev_mock_up.sh
/.dev-logs/

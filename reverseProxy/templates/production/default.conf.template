# Production reverse proxy (the image default): HTTPS for ${NGINX_SERVER_NAME}.
#
# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# Only NGINX_* environment variables are substituted (NGINX_ENVSUBST_FILTER in the
# Dockerfile), so nginx variables such as $host and $request_uri are kept.
# envsubst does not support shell defaults (VAR:-default); the default server
# name is set with ENV in the Dockerfile and can be overridden from compose.
#
# nginx needs the Let's Encrypt certificate in /etc/letsencrypt/live/<server name>/
# before it can start; see docs/DEPLOY.md for the first issuance and renewal.

server_tokens off;

# Any other host name, or a request by IP address or without a Host header / SNI:
# close the connection without an answer (444), and refuse the TLS handshake on
# 443 (no certificate needed), so only ${NGINX_SERVER_NAME} is ever served.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# Port 80: only the ACME HTTP-01 challenge (certbot --webroot) is served over
# plain HTTP. Everything else is redirected to HTTPS on the configured name (not
# the client's Host header).
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${NGINX_SERVER_NAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${NGINX_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_SERVER_NAME}/privkey.pem;

    # Mozilla "intermediate" profile (TLS 1.2 + 1.3, forward-secret AEAD ciphers).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:GradeViewTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers, set once here for every response (including errors).
    # HSTS: one year, without includeSubDomains (other *.eecs.berkeley.edu hosts
    # are not ours) and without preload.
    # No X-Frame-Options / CSP frame-ancestors on purpose: concept-map pages may
    # be embedded in bCourses.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    include /etc/nginx/snippets/gradeview-locations.conf;
}

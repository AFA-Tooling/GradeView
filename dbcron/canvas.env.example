# Canvas importer settings (add to dbcron/.env). Never commit real tokens.
# Local mock course: CANVAS_BASE_URL=http://localhost:8080 (see ~/canvas-lms/gv_mock/README.md)
CANVAS_BASE_URL=https://bcourses.berkeley.edu
CANVAS_COURSE_ID=
CANVAS_TOKEN=
# Course total used for letter-grade bins; set it while the course is still adding assignments (CS10: 400)
CANVAS_TOTAL_POINTS=
# Optional JSON map of per-group points for the bins page, e.g. {"Labs": 40, "Projects": 145}
CANVAS_ASSIGNMENT_POINTS=
# An assignment enters MAX POINTS once a rostered student can see a score. Opt-ins (default false):
#   CANVAS_RELEASE_ON_DUE=true  also release when the due date passes (students then see 0 until grades post)
#   CANVAS_INCLUDE_FUTURE=true  release everything now (breaks pace/projections early in the term)
CANVAS_RELEASE_ON_DUE=false
CANVAS_INCLUDE_FUTURE=false
# Optional JSON map from Canvas assignment-group names to GradeView category names
CANVAS_CATEGORY_MAP={}
# Redis (same names as update_db.py); DB2 holds canvas:admins and canvas:sync_meta and is never flushed
SERVER_HOST=redis
SERVER_PORT=6379
SERVER_DBINDEX=0
BINS_DBINDEX=1
ADMIN_DBINDEX=2
REDIS_DB_SECRET=

# Build-context exclusions for the website dev image (website/Dockerfile,
# `react-scripts start`; compose does not use this image, it builds
# website/server instead).
Dockerfile
.dockerignore
.git
**/.DS_Store

# Dependencies are installed by `npm ci`; build output is regenerated
node_modules
**/node_modules
build
server/build

# Secrets: env files, keys, certificates
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
*.pem
*.key
**/*.pem
**/*.key
# Exception: .env.local is tracked in git (so it is not a secret) and is read by
# Create React App. This image runs the dev server (`react-scripts start`, which
# also loads src/setupProxy.js), so keep it to behave like a checkout. The
# production bundle does not depend on it (`react-scripts build` output is
# identical with and without it). REACT_APP_* values end up in the public
# bundle, so never put secrets in it.
!.env.local

*.log
npm-debug.log*

# Local Python environments and data dumps (Canvas dumps contain student data)
venv/
.venv/
**/__pycache__/
dumps/

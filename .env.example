# Copy this file to .env (cp .env.example .env). Never commit .env.

# --- Local fake-data setup (make mock-up) ---
# Your berkeley.edu email: you sign in with it and become the only admin on your machine.
DEV_ADMIN_EMAIL=your_email@berkeley.edu
# Any password for the local Redis (only used on your laptop).
REDIS_DB_SECRET=change-me-local-only

# --- Full Docker stack (make dev-up / docker compose); not needed for make mock-up ---
# REDIS_DB_SECRET above is REQUIRED here too: both compose files refuse to start
# without it, start Redis with it and pass it to the API. On the production server
# use a long random value made of letters and digits only (it goes into a redis://
# URL), e.g. `openssl rand -hex 32`, and put the same value in dbcron/.env.
# See docs/DEPLOY.md.
API_PORT=8000
REACT_APP_PORT=3000
REACT_APP_PROXY_SERVER=http://api:8000
# Port the progress report listens on inside its container. nginx proxies
# /progress to dtgui-progress-report:8080, so keep 8080.
PROGRESS_REPORT_PORT=8080
# docker-compose.dev.yml only: host address:port for the HTTP dev proxy.
# 127.0.0.1 keeps it off your network; production always publishes 80 and 443.
REVERSE_PROXY_LISTEN=127.0.0.1:80
# Production (docker-compose.yml): public host name. nginx loads the certificate
# from /etc/letsencrypt/live/$NGINX_SERVER_NAME/. Optional, this is the default.
NGINX_SERVER_NAME=gradeview.eecs.berkeley.edu
